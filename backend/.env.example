# ==============================================================================
# Backend Configuration Template — Copy to .env
# ==============================================================================

PROJECT_NAME="Personalized AI Children's Storybook"
API_V1_PREFIX=/api/v1
PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/kuttystory_db

# Security
SECRET_KEY=replace-with-a-secure-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Credentials
# 1. Google Gemini API Key (for story narrative & character personalization — https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# 2. Hugging Face Access Token (MANDATORY for the 3D realistic AI Neural Face Swap — https://huggingface.co/settings/tokens)
HF_TOKEN=
HF_MODEL_NAME=stabilityai/stable-diffusion-xl-base-1.0
# High-Definition Face Swap Space with Neural Face Enhancer (GFPGAN/CodeFormer)
HF_FACE_SWAP_SPACE=ovi054/face-swap-pro
HF_FACE_SWAP_ENHANCE=true

# Providers
ACTIVE_STORY_PROVIDER=gemini
# Keep 'template_fusion' to enable the 3D storybook AI Face Swap (powered by Hugging Face + Gradio)
ACTIVE_IMAGE_PROVIDER=template_fusion

# Limits
PER_BOOK_BUDGET_USD=2.50
PREVIEW_PAGE_LIMIT=5
MAX_GENERATION_RETRIES=3
PAID_FALLBACK_ENABLED=false

# SMTP Password Reset Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="Kutty Stories"
SMTP_USE_TLS=true
PASSWORD_RESET_CODE_EXPIRE_MINUTES=5

# Razorpay Payment Gateway Credentials (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# CORS Allowed Origins (comma-separated list of permitted origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,https://apikuttystory.risingsuntech.in,https://kuttystory.risingsuntech.in,*


