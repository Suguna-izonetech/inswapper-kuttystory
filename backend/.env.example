# ==============================================================================
# Backend Configuration Template — Copy to .env
# ==============================================================================

PROJECT_NAME="Personalized AI Children's Storybook"
API_V1_PREFIX=/api/v1
PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+pg8000://postgres:your_password@localhost:5432/kuttystory_db

# Security
SECRET_KEY=replace-with-a-secure-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Credentials
# 1. Google Gemini API Key (for story narrative & character personalization — https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# 2. Hugging Face Access Token (MANDATORY for the 3D realistic AI Neural Face Swap — https://huggingface.co/settings/tokens)
HF_TOKEN=
HF_MODEL_NAME=stabilityai/stable-diffusion-xl-base-1.0
# High-Definition Face Swap Space with Neural Face Enhancer (GFPGAN/CodeFormer)
HF_FACE_SWAP_SPACE=ovi054/face-swap-pro
HF_FACE_SWAP_ENHANCE=true

# Providers
ACTIVE_STORY_PROVIDER=gemini
# Keep 'template_fusion' to enable the 3D storybook AI Face Swap (powered by Hugging Face + Gradio)
ACTIVE_IMAGE_PROVIDER=template_fusion

# Limits
PER_BOOK_BUDGET_USD=2.50
PREVIEW_PAGE_LIMIT=5
MAX_GENERATION_RETRIES=3
PAID_FALLBACK_ENABLED=false
