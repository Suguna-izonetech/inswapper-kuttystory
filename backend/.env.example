# ==============================================================================
# Backend Configuration Template — Copy to .env
# ==============================================================================

PROJECT_NAME="Personalized AI Children's Storybook"
API_V1_PREFIX=/api/v1
PORT=8000

# Database (SQLite by default, or PostgreSQL)
DATABASE_URL=sqlite:///./storybook.db

# Security
SECRET_KEY=replace-with-a-secure-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional AI Credentials
GEMINI_API_KEY=
HF_TOKEN=
HF_MODEL_NAME=stabilityai/stable-diffusion-xl-base-1.0

# Providers
ACTIVE_STORY_PROVIDER=gemini
ACTIVE_IMAGE_PROVIDER=huggingface

# Limits
PER_BOOK_BUDGET_USD=2.50
PREVIEW_PAGE_LIMIT=5
MAX_GENERATION_RETRIES=3
PAID_FALLBACK_ENABLED=false
